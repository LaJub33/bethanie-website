---

---

<section id="notification-banner" hidden>
    <a href="" id="notification-link" class="notification-banner">
        <img id="notification-image" class="notification-image" alt="" />
        <div class="notification-content">
            <span class="notification-badge">À ne pas rater !</span>
            <h2 id="notification-titre" class="notification-titre"></h2>
            <p id="notification-description" class="notification-description">
            </p>
            <p id="notification-infos" class="notification-infos"></p>
        </div>
        <span class="notification-arrow"><i class="ph ph-arrow-right"></i></span
        >
    </a>
</section>

<style is:global>
    .notification-banner {
        display: flex;
        align-items: stretch;
        gap: 24px;
        padding: 24px 40px;
        width: 100%;
        border-radius: var(--border-radius);
        background-color: var(--color-background);
        text-decoration: none;
    }

    .notification-image {
        width: 280px;
        height: 180px;
        object-fit: cover;
        border-radius: var(--border-radius);
        flex-shrink: 0;
    }

    .notification-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 8px;
        flex: 1;
        min-width: 0;
    }

    .notification-badge {
        align-self: flex-start;
        padding: 4px 12px;
        border-radius: 999px;
        background-color: var(--color-primary);
        color: var(--color-white);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .notification-titre {
        font-size: 28px;
        text-transform: uppercase;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .notification-description {
        color: var(--color-body40W);
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .notification-infos {
        font-weight: 700;
        text-transform: uppercase;
    }

    .notification-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        align-self: center;
        width: 40px;
        height: 40px;
        border-radius: 999px;
        background-color: var(--color-white);
        flex-shrink: 0;
    }

    @media (max-width: 700px) {
        .notification-banner {
            flex-direction: column;
            padding: 24px;
            gap: 16px;
        }

        .notification-image {
            width: 100%;
            height: 160px;
        }

        .notification-arrow {
            display: none;
        }
    }
</style>

<script>
    import { supabase } from "../lib/supabase.js";

    const banner = document.querySelector<HTMLElement>("#notification-banner")!;
    const link =
        document.querySelector<HTMLAnchorElement>("#notification-link")!;
    const image = document.querySelector<HTMLImageElement>(
        "#notification-image",
    )!;
    const titre = document.querySelector<HTMLElement>("#notification-titre")!;
    const description = document.querySelector<HTMLElement>(
        "#notification-description",
    )!;
    const infos = document.querySelector<HTMLElement>("#notification-infos")!;

    const { data: settings } = await supabase
        .from("site_settings")
        .select("bandeau_evenement_actif")
        .eq("id", 1)
        .maybeSingle();

    if (settings?.bandeau_evenement_actif) {
        const { data: evenement } = await supabase
            .from("evenements")
            .select("*")
            .gte("date", new Date().toISOString().slice(0, 10))
            .order("date", { ascending: true })
            .limit(1)
            .maybeSingle();

        if (evenement) {
            link.href = `/l-agenda/evenement?id=${evenement.id}`;

            if (evenement.image) {
                image.src = evenement.image;
                image.alt = evenement.titre;
            } else {
                image.remove();
            }

            titre.textContent = evenement.titre;

            if (evenement.description) {
                description.textContent = evenement.description;
            } else {
                description.remove();
            }

            const date = new Date(`${evenement.date}T00:00:00`);
            const dateComplete = date.toLocaleDateString("fr-FR", {
                weekday: "long",
                day: "numeric",
                month: "long",
            });
            infos.textContent = `${dateComplete} · ${evenement.heure_debut.slice(0, 5)} – ${evenement.heure_fin.slice(0, 5)}`;

            banner.hidden = false;
        }
    }
</script>
