<section class="contact-banner">
    <div class="col1">
        <h2>Contact</h2>
        <p>
            Pour toute question, renseignement, demande de disponibilité,
            n’hésitez pas à nous contacter !
        </p>
    </div>
    <div class="col2">
        <div class="row">
            <div class="col">
                <p>Par téléphone</p>
                <p class="bold">06 05 71 88 48</p>
            </div>
            <div class="separator"></div>
            <div class="col">
                <p>Par email</p>
                <p class="bold">contact@labethanie.fr</p>
            </div>
        </div>
        <a href="/la-ferme" class="btn"
            >Plus d'infos <i class="ph ph-arrow-up-right"></i></a
        >
    </div>
</section>

<style>
    .contact-banner {
        width: 100%;
        display: flex;
        flex-direction: row;
        gap: 40px;
        padding: 40px;
        background-color: var(--color-background);
        border-radius: var(--border-radius);
    }

    .col1 {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .col2 {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 40px;
        align-items: center;
    }

    .row {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        width: 100%;
    }

    .row .separator {
        width: 1px;
        height: 100%;
        background-color: var(--color-body40W);
    }

    .row .col {
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: center;
        flex: 1;
    }

    .bold {
        font-weight: bold;
        color: var(--color-primary);
    }

    @media (max-width: 900px) {
        .contact-banner {
            flex-direction: column;
        }
    }

    @media (max-width: 500px) {
        .contact-banner {
            padding: 24px;
        }

        .row {
            flex-direction: column;
            gap: 16px;
        }

        .row .separator {
            width: 100%;
            height: 1px;
        }
    }
</style>
