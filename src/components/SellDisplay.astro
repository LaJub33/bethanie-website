---

<section class="bandeau-vente">
    <div class="container">
        <div class="first-container">
            <p class="title-container">Où trouver nos légumes ?</p>
            <div class="line-separator"></div>
        </div>

        <div class="marche-a-la-ferme">
            <p class="title-section">Marché à la ferme</p>
            <p>Tous les vendredis de 16h à 19h</p>
            <a href="https://goo.gl/maps/1Z5g6J8J8J8J8J8J8" target="_blank"
                >181 Fournié Ouest, Saint-Morillon</a
            >
        </div>

        <div class="commandez-votre-panier">
            <p class="title-section">Commandez votre panier</p>

            <!-- Début de semaine -->
            <p class="subtitle-section">Début de semaine</p>
            <p><span>Commande</span> : lundi 12h à minuit</p>
            <p><span>Retrait</span> : mardi de 16h à 19h</p>

            <!-- Fin de semaine -->
            <p class="subtitle-section">Fin de semaine</p>
            <p><span>Commande</span> : jeudi 12h à minuit</p>
            <p><span>Retrait</span> : vendredi de 16h à 19h</p>

            <a
                href="https://boutique.ouvretaferme.org/la-bethanie"
                class="btn"
                target="_blank"
            >
                Commander mon panier <i class="ph ph-arrow-up-right"></i>
            </a>
        </div>
    </div>
    <img src="/chou.jpg" alt="" class="background-image chou" />
    <img src="/laitue.jpg" alt="" class="background-image laitue" />
</section>

<style>
    .bandeau-vente {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 24px;
        color: var(--color-body);
        position: relative;
        gap: 40px;

        border-radius: var(--border-radius);
        overflow: hidden;

        border-right: 8px solid var(--color-primary);
        border-bottom: 8px solid var(--color-primary);
    }

    .background-image {
        position: absolute;
        width: fit-content;
        object-fit: cover;
        z-index: -1;
    }

    .background-image.chou {
        bottom: 0;
        left: 0;
    }

    .background-image.laitue {
        top: 0;
        right: 0;
    }

    .bandeau-vente .container {
        width: 100%;
        display: flex;
        position: relative;
        vertical-align: middle;
        gap: 40px;
        overflow: hidden;
        border-radius: var(--border-radius);
    }

    .bandeau-vente .first-container {
        display: flex;
        flex-direction: row;
        gap: 8px;
        width: fit-content;
    }

    .bandeau-vente .title-container {
        font-size: 32px;
        font-weight: 800;
        width: 216px;
        text-transform: uppercase;
        align-self: center;
    }

    .bandeau-vente .line-separator {
        width: 1px;
        height: 174px;
        background-color: var(--color-body);
        align-self: center;
    }

    .bandeau-vente .marche-a-la-ferme,
    .bandeau-vente .commandez-votre-panier {
        display: flex;
        flex-direction: column;
        gap: 8px;
        width: 50%;
        align-self: center;
    }

    .bandeau-vente .marche-a-la-ferme .title-section,
    .bandeau-vente .commandez-votre-panier .title-section {
        font-size: 24px;
        font-weight: bold;
        text-transform: uppercase;
    }

    .bandeau-vente .marche-a-la-ferme p {
        font-size: 16px;
        font-weight: 400;
    }

    .bandeau-vente .marche-a-la-ferme a {
        color: var(--color-primary);
        text-decoration: underline;
        font-size: 12px;
        font-weight: 300;
        width: fit-content;
    }

    .bandeau-vente .subtitle-section {
        font-size: 16px;
        font-weight: 600;
        color: var(--color-primary);
        text-transform: uppercase;
    }

    .bandeau-vente .commandez-votre-panier span {
        text-decoration: underline;
    }

    .bandeau-vente a {
        color: var(--color-primary);
        text-decoration: underline;
    }

    @media (max-width: 900px) {
        .bandeau-vente {
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 60vh;
        }

        .bandeau-vente .container {
            flex-direction: column;
            max-width: 480px;
        }

        .bandeau-vente .first-container {
            flex-direction: column;
            width: 100%;
        }

        .bandeau-vente .title-container {
            width: 100%;
        }

        .bandeau-vente .line-separator {
            width: 100%;
            height: 1px;
        }

        .bandeau-vente .marche-a-la-ferme,
        .bandeau-vente .commandez-votre-panier {
            width: 100%;
        }
    }
</style>
