---

---

<section class="bandeau-vente">
    <div class="image-col">
        <img
            src="/sell-display-image.jpg"
            alt="Rangs de légumes sous serre"
        />
        <p class="title-overlay">
            Où<br />trouver<br />nos<br />légumes ?
        </p>
    </div>

    <div class="content-col">
        <div class="vente-en-ligne">
            <p class="surtitle">Vente en ligne</p>
            <p class="titre">Les lundis et jeudis</p>

            <div class="etape">
                <span class="numero">1</span>
                <p>
                    Commandez sur notre site <span class="bold"
                        >entre 12h et minuit</span
                    >
                </p>
            </div>
            <div class="etape">
                <span class="numero">2</span>
                <p>
                    Retirez votre commande <span class="bold"
                        >le lendemain 16h à 19h (les mardis et vendredis)</span
                    >
                </p>
            </div>

            <a
                href="https://boutique.ouvretaferme.org/la-bethanie"
                class="btn"
                target="_blank"
            >
                Commander mon panier
            </a>
        </div>

        <div class="marche-a-la-ferme">
            <p class="surtitle">Marché à la ferme</p>
            <p class="titre">Les vendredis</p>
            <p>
                Venez acheter vos produits à la ferme <span class="bold"
                    >tous les vendredis de 16h à 19h</span
                >
            </p>

            <div class="adresse-box">
                <p class="adresse-intro">
                    Le retrait des commandes et le marché à la ferme se font
                    au :
                </p>
                <a
                    href="https://goo.gl/maps/1Z5g6J8J8J8J8J8J8"
                    target="_blank"
                    class="adresse-lien"
                >
                    181 Fournié Ouest, Saint Morillon 33650
                </a>
                <img src="/MapPin.svg" alt="" class="map-pin" />
            </div>
        </div>
    </div>
</section>

<style>
    .bandeau-vente {
        display: flex;
        flex-direction: row;
        width: 100%;
        border-radius: var(--border-radius);
        overflow: hidden;
        background-color: var(--color-white);
        box-shadow: 0px 0px 25px #13624112;
    }

    .image-col {
        position: relative;
        flex: 0 0 28%;
        min-width: 260px;
    }

    .image-col img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .image-col::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            180deg,
            rgba(0, 0, 0, 0.55) 0%,
            rgba(0, 0, 0, 0.2) 45%,
            rgba(0, 0, 0, 0) 70%
        );
    }

    .title-overlay {
        position: absolute;
        top: 50%;
        left: 0;
        transform: translateY(-50%);
        padding: 24px;
        color: var(--color-white);
        font-size: 40px;
        font-weight: 800;
        line-height: 1.1;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .content-col {
        flex: 1;
        display: flex;
        flex-direction: row;
        gap: 40px;
        padding: 24px;
    }

    .vente-en-ligne,
    .marche-a-la-ferme {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .surtitle {
        font-size: 16px;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--color-primary);
    }

    .titre {
        font-size: 28px;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--color-body);
        line-height: 1.1;
        margin-bottom: 8px;
    }

    .bold {
        font-weight: 700;
    }

    .etape {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 8px;
    }

    .numero {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        margin-top: 2px;
        border: 1px solid var(--color-body);
        border-radius: 50%;
        font-size: 12px;
        font-weight: 600;
    }

    .vente-en-ligne .btn {
        margin-top: 16px;
    }

    .adresse-box {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-top: 16px;
        padding: 16px 20px;
        border-radius: var(--border-radius);
        background-color: var(--color-background);
    }

    .adresse-intro {
        font-size: 14px;
        color: var(--color-body40W);
    }

    .adresse-lien {
        font-size: 14px;
        font-weight: 600;
        color: var(--color-primary);
        text-decoration: underline;
    }

    .adresse-box .map-pin {
        position: absolute;
        bottom: -10px;
        right: -10px;
        width: 90px;
        height: auto;
    }

    @media (max-width: 900px) {
        .bandeau-vente {
            flex-direction: column;
        }

        .image-col {
            flex: none;
            width: 100%;
            height: 220px;
        }

        .content-col {
            flex-direction: column;
            padding: 24px;
        }
    }
</style>
