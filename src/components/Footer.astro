---

---

<footer>
    <div class="list-container">
        <div class="row1">
            <nav>
                <ul>
                    <li><a href="#about">Accueil</a></li>
                    <li><a href="#services">Se nourrir</a></li>
                    <li><a href="#contact">La ferme</a></li>
                    <li><a href="#contact">L'association</a></li>
                    <li><a href="#contact">L'agenda</a></li>
                    <li><a href="#contact">Contact</a></li>
                </ul>
            </nav>
        </div>
        <div class="row2">
            <p>Demandez la newsletter</p>
            <form
                class="footer-newsletter-form"
                method="post"
                target="brevo-newsletter-frame-footer"
            >
                <input
                    type="email"
                    name="EMAIL"
                    placeholder="email@labethanie.fr"
                    required
                />
                <input type="hidden" name="email_address_check" value="" />
                <input type="hidden" name="locale" value="fr" />
                <button type="submit">S'abonner</button>
            </form>
            <iframe name="brevo-newsletter-frame-footer" hidden></iframe>
            <p class="confirmation" hidden>Merci, vous êtes abonné !</p>
            <p class="error-message" hidden>
                Une erreur est survenue, veuillez réessayer.
            </p>
        </div>
    </div>
    <div class="logo-container">
        <a href="">
            <img
                src="/logo-full-white.svg"
                alt="Logo de Bethanie"
            />
        </a>
    </div>
    <div class="credentials-container">
        <div class="row1">
            <a href="">@fermelabethanie</a>
            <p>06 06 06 06 06</p>
            <a href="mailto:contact@labethanie.fr">contact@labethanie.fr</a>
            <p>Saint-Morillon, 33650 France</p>
        </div>
        <div class="row2">
            <p>© 2026 La Bethanie</p>
        </div>
    </div>

    <style>
        /* FOOTER */
        footer {
            width: 100%;
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            background-color: var(--color-primary);
            color: var(--color-white);
            padding: 80px;
            gap: 40px;
        }

        footer .list-container,
        .credentials-container {
            width: 100%;
        }

        footer a,
        p {
            text-decoration: none;
            color: var(--color-white);
            font-weight: 300;
        }

        /* FOOTER - LIST CONTAINER */

        footer .list-container {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 40px;
        }

        footer .list-container .row1 ul {
            display: flex;
            flex-direction: column;
            list-style: none;
            gap: 8px;
        }

        footer .list-container .row2 {
            display: flex;
            flex-direction: column;
            gap: 8px;
            align-items: left;
        }

        footer .list-container .row2 input {
            padding: 16px;
            border: none;
            border-radius: 4px;
            background-color: #ffffff25;
            border-radius: 4px;
            border: none;
            color: var(--color-white);
            width: 100%;
        }

        footer .list-container .row2 form {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        footer .list-container .row2 button {
            padding: 16px;
            border: none;
            border-radius: 4px;
            background-color: var(--color-white);
            color: var(--color-primary);
            font-weight: 500;
            font-size: 16px;
            cursor: pointer;
            text-transform: uppercase;
        }

        footer .list-container .row2 .error-message {
            color: #ffb4a8;
        }

        /* FOOTER - LOGO CONTAINER */
        footer .logo-container {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* FOOTER - CREDENTIALS CONTAINER */
        footer .credentials-container {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 40px;
            text-align: right;
        }

        footer .credentials-container * {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        @media (max-width: 900px) {
            footer {
                flex-direction: column;
                padding: 40px;
            }

            footer .credentials-container {
                text-align: left;
            }
        }

        @media (max-width: 500px) {
            footer .credentials-container .row1 {
                text-align: left;
            }
        }
    </style>

    <script>
        const BREVO_FORM_ACTION = import.meta.env.PUBLIC_BREVO_FORM_ACTION;

        const form = document.querySelector<HTMLFormElement>(
            "footer .footer-newsletter-form",
        );
        const frame = document.querySelector<HTMLIFrameElement>(
            "iframe[name=brevo-newsletter-frame-footer]",
        );
        const confirmation = document.querySelector<HTMLElement>(
            "footer .list-container .row2 .confirmation",
        );
        const errorMessage = document.querySelector<HTMLElement>(
            "footer .list-container .row2 .error-message",
        );
        const submitButton =
            form?.querySelector<HTMLButtonElement>("button[type=submit]");

        if (form) form.action = BREVO_FORM_ACTION;

        form?.addEventListener("submit", (event) => {
            const email = new FormData(form).get("EMAIL");
            if (typeof email !== "string" || !email) {
                event.preventDefault();
                return;
            }

            if (!BREVO_FORM_ACTION) {
                event.preventDefault();
                errorMessage?.removeAttribute("hidden");
                return;
            }

            errorMessage?.setAttribute("hidden", "");
            if (submitButton) submitButton.disabled = true;

            frame?.addEventListener(
                "load",
                () => {
                    if (submitButton) submitButton.disabled = false;
                    form.reset();
                    confirmation?.removeAttribute("hidden");
                    setTimeout(
                        () => confirmation?.setAttribute("hidden", ""),
                        4000,
                    );
                },
                { once: true },
            );
        });
    </script>
</footer>
