---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Administration">
    <div class="wrapper">
        <section class="admin-home" hidden>
            <div class="header-row">
                <h1>Administration</h1>
                <div id="logged-in-as">
                    <p>Connecté en tant que <strong id="admin-email"></strong></p>
                    <button type="button" id="logout-button">Se déconnecter</button>
                </div>
            </div>

            <nav class="admin-pages">
                <a href="/admin/evenements" class="admin-page-tile">
                    <h2>Gestion des évènements</h2>
                    <p>Ajouter ou supprimer les évènements de l'agenda.</p>
                    <i class="ph ph-arrow-right"></i>
                </a>
            </nav>

            <div class="admin-settings">
                <h2>Paramètres</h2>
                <label class="setting-row">
                    <div>
                        <p class="setting-label"
                            >Bandeau du prochain évènement</p
                        >
                        <p class="setting-hint"
                            >Afficher sur la page d'accueil un bandeau mettant
                            en avant le prochain évènement à venir.</p
                        >
                    </div>
                    <span class="switch">
                        <input type="checkbox" id="bandeau-toggle" />
                        <span class="switch-track"></span>
                    </span>
                </label>
            </div>
        </section>
    </div>
</Layout>

<style is:global>
    .admin-home {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .admin-home .header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .admin-home #logged-in-as {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .admin-pages {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-width: 480px;
    }

    .admin-page-tile {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 24px;
        border-radius: var(--border-radius);
        background-color: var(--color-background);
        text-decoration: none;
        position: relative;
    }

    .admin-page-tile h2 {
        font-size: 20px;
    }

    .admin-page-tile p {
        color: var(--color-body40W);
    }

    .admin-page-tile i {
        position: absolute;
        top: 24px;
        right: 24px;
    }

    .admin-settings {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-width: 480px;
    }

    .admin-settings h2 {
        font-size: 20px;
    }

    .setting-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 24px;
        border-radius: var(--border-radius);
        background-color: var(--color-background);
        cursor: pointer;
    }

    .setting-label {
        font-weight: 600;
    }

    .setting-hint {
        font-size: 14px;
        color: var(--color-body40W);
    }

    .switch {
        position: relative;
        flex-shrink: 0;
        display: inline-block;
        width: 44px;
        height: 24px;
    }

    .switch input {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
    }

    .switch-track {
        position: absolute;
        inset: 0;
        background-color: var(--color-body40W);
        border-radius: 999px;
        transition: background-color 0.2s ease;
    }

    .switch-track::before {
        content: "";
        position: absolute;
        height: 18px;
        width: 18px;
        left: 3px;
        top: 3px;
        background-color: var(--color-white);
        border-radius: 50%;
        transition: transform 0.2s ease;
    }

    .switch input:checked + .switch-track {
        background-color: var(--color-primary);
    }

    .switch input:checked + .switch-track::before {
        transform: translateX(20px);
    }
</style>

<script>
    import { supabase } from "../../lib/supabase.js";
    import { requireAdminSession } from "../../lib/adminAuth.js";

    const adminHome = document.querySelector<HTMLElement>(".admin-home")!;
    const adminEmail = document.querySelector<HTMLElement>("#admin-email")!;
    const logoutButton =
        document.querySelector<HTMLButtonElement>("#logout-button")!;
    const bandeauToggle =
        document.querySelector<HTMLInputElement>("#bandeau-toggle")!;

    const session = await requireAdminSession();
    if (session) {
        adminEmail.textContent = session.user.email ?? "";
        adminHome.hidden = false;

        const { data: settings } = await supabase
            .from("site_settings")
            .select("bandeau_evenement_actif")
            .eq("id", 1)
            .maybeSingle();

        bandeauToggle.checked = settings?.bandeau_evenement_actif ?? false;
    }

    bandeauToggle.addEventListener("change", async () => {
        const checked = bandeauToggle.checked;
        const { error } = await supabase
            .from("site_settings")
            .update({ bandeau_evenement_actif: checked })
            .eq("id", 1);

        if (error) {
            alert(error.message);
            bandeauToggle.checked = !checked;
        }
    });

    logoutButton.addEventListener("click", async () => {
        await supabase.auth.signOut();
        window.location.href = "/admin/login";
    });
</script>
