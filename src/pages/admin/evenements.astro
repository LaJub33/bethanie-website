---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Administration - Évènements">
    <div class="wrapper">
        <section class="admin-evenements">
            <div class="header-row">
                <a href="/admin" class="back-link"
                    ><i class="ph ph-arrow-left"></i> Administration</a
                >
                <span id="supabase-status" class="chip chip-checking"
                    >Vérification…</span
                >
            </div>

            <div id="admin-panel" hidden>
                <div id="logged-in-as">
                    <h1>Administration des évènements</h1>
                    <div>
                        <span
                            >Connecté en tant que <strong id="admin-email"
                            ></strong></span
                        >
                        <button type="button" id="logout-button"
                            >Se déconnecter</button
                        >
                    </div>
                </div>

                <h2>Évènements à venir</h2>
                <div id="events-list"></div>

                <h2 id="event-form-title">Ajouter un évènement</h2>
                <form id="add-event-form">
                    <div class="field">
                        <label for="event-date">Date</label>
                        <input id="event-date" type="date" name="date" required />
                    </div>
                    <div class="field">
                        <label for="event-heure-debut">Heure de début</label>
                        <input
                            id="event-heure-debut"
                            type="time"
                            name="heure_debut"
                            required
                        />
                    </div>
                    <div class="field">
                        <label for="event-heure-fin">Heure de fin</label>
                        <input
                            id="event-heure-fin"
                            type="time"
                            name="heure_fin"
                            required
                        />
                    </div>
                    <div class="field">
                        <label for="event-titre">Titre de l'évènement</label>
                        <input id="event-titre" type="text" name="titre" required />
                    </div>
                    <div class="field">
                        <label for="event-description"
                            >Description (optionnel)</label
                        >
                        <textarea
                            id="event-description"
                            name="description"
                            rows="4"
                        ></textarea>
                        <p class="field-hint">
                            Affichée uniquement sur la page de l'évènement, pas
                            sur sa fiche dans l'agenda.
                        </p>
                    </div>
                    <div class="field">
                        <label for="event-lien">Lien (optionnel)</label>
                        <input id="event-lien" type="url" name="lien" />
                    </div>
                    <div class="field">
                        <label for="event-image">Image (optionnel)</label>
                        <input
                            id="event-image"
                            type="file"
                            name="image"
                            accept="image/jpeg,image/png"
                        />
                        <p id="event-image-hint" class="field-hint" hidden>
                            Laissez vide pour conserver l'image actuelle.
                        </p>
                    </div>
                    <div class="form-actions">
                        <button type="submit" id="submit-event-button" class="btn"
                            >Ajouter</button
                        >
                        <button
                            type="button"
                            id="cancel-edit-button"
                            class="btn-secondary"
                            hidden>Annuler</button
                        >
                    </div>
                </form>
            </div>
        </section>
    </div>
</Layout>

<style is:global>
    .admin-evenements {
        display: flex;
        flex-direction: column;
        gap: 24px;
        max-width: 600px;
    }

    .header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .back-link {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: var(--color-body);
    }

    .chip {
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .chip-checking {
        background-color: var(--color-body40W);
        color: var(--color-white);
    }

    .chip-online {
        background-color: var(--color-primary);
        color: var(--color-white);
    }

    .chip-offline {
        background-color: #c0392b;
        color: var(--color-white);
    }

    #add-event-form:not([hidden]) {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    #logged-in-as {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    #logged-in-as > div {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    #add-event-form input,
    #add-event-form textarea {
        padding: 12px;
        border: 1px solid var(--color-body40W);
        border-radius: var(--border-radius);
        font-family: inherit;
        resize: vertical;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .field label {
        font-weight: 600;
        font-size: 14px;
    }

    .field-hint {
        font-size: 12px;
        color: var(--color-body40W);
    }

    .form-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .btn-secondary {
        padding: 12px 24px;
        border: 1px solid var(--color-body40W);
        border-radius: var(--border-radius);
        background-color: transparent;
        cursor: pointer;
    }

    .error {
        color: red;
    }

    .event-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        border-radius: var(--border-radius);
        background-color: var(--color-background);
        margin-bottom: 8px;
    }

    .event-row span {
        flex: 1;
    }

    .event-row .event-thumb {
        width: 48px;
        height: 48px;
        object-fit: cover;
        border-radius: var(--border-radius);
        flex-shrink: 0;
    }
</style>

<script>
    import { supabase } from "../../lib/supabase.js";
    import { requireAdminSession } from "../../lib/adminAuth.js";

    const adminPanel = document.querySelector<HTMLElement>("#admin-panel")!;
    const adminEmail = document.querySelector<HTMLElement>("#admin-email")!;
    const eventsList = document.querySelector<HTMLElement>("#events-list")!;
    const addEventForm =
        document.querySelector<HTMLFormElement>("#add-event-form")!;
    const logoutButton =
        document.querySelector<HTMLButtonElement>("#logout-button")!;
    const supabaseStatus =
        document.querySelector<HTMLElement>("#supabase-status")!;
    const eventFormTitle =
        document.querySelector<HTMLElement>("#event-form-title")!;
    const submitEventButton =
        document.querySelector<HTMLButtonElement>("#submit-event-button")!;
    const cancelEditButton =
        document.querySelector<HTMLButtonElement>("#cancel-edit-button")!;
    const eventImageHint =
        document.querySelector<HTMLElement>("#event-image-hint")!;

    let editingEvent: { id: string; image: string | null } | null = null;

    function resetForm() {
        editingEvent = null;
        addEventForm.reset();
        eventFormTitle.textContent = "Ajouter un évènement";
        submitEventButton.textContent = "Ajouter";
        cancelEditButton.hidden = true;
        eventImageHint.hidden = true;
    }

    function startEdit(evenement: {
        id: string;
        date: string;
        heure_debut: string;
        heure_fin: string;
        titre: string;
        description: string | null;
        lien: string | null;
        image: string | null;
    }) {
        editingEvent = { id: evenement.id, image: evenement.image };

        addEventForm.date.value = evenement.date;
        addEventForm.heure_debut.value = evenement.heure_debut;
        addEventForm.heure_fin.value = evenement.heure_fin;
        addEventForm.titre.value = evenement.titre;
        addEventForm.description.value = evenement.description ?? "";
        addEventForm.lien.value = evenement.lien ?? "";

        eventFormTitle.textContent = "Modifier l'évènement";
        submitEventButton.textContent = "Enregistrer";
        cancelEditButton.hidden = false;
        eventImageHint.hidden = false;

        addEventForm.scrollIntoView({ behavior: "smooth" });
    }

    async function checkSupabaseStatus() {
        const timeout = new Promise<never>((_, reject) =>
            setTimeout(() => reject(new Error("timeout")), 5000),
        );

        try {
            const result = await Promise.race([
                supabase.from("evenements").select("id", {
                    count: "exact",
                    head: true,
                }),
                timeout,
            ]);

            if (result.error) throw result.error;

            supabaseStatus.textContent = "Supabase actif";
            supabaseStatus.className = "chip chip-online";
        } catch {
            supabaseStatus.textContent =
                "Supabase injoignable (projet en pause ?)";
            supabaseStatus.className = "chip chip-offline";
        }
    }

    checkSupabaseStatus();

    async function loadEvents() {
        const { data, error } = await supabase
            .from("evenements")
            .select("*")
            .order("date", { ascending: true });

        if (error) {
            eventsList.innerHTML = `<p>Erreur : ${error.message}</p>`;
            return;
        }

        eventsList.innerHTML = "";
        for (const evenement of data) {
            const row = document.createElement("div");
            row.className = "event-row";

            if (evenement.image) {
                const thumb = document.createElement("img");
                thumb.src = evenement.image;
                thumb.alt = "";
                thumb.className = "event-thumb";
                row.appendChild(thumb);
            }

            const info = document.createElement("span");
            info.textContent = `${evenement.date} · ${evenement.heure_debut}–${evenement.heure_fin} · ${evenement.titre}`;

            const editButton = document.createElement("button");
            editButton.type = "button";
            editButton.textContent = "Modifier";
            editButton.addEventListener("click", () => startEdit(evenement));

            const deleteButton = document.createElement("button");
            deleteButton.type = "button";
            deleteButton.textContent = "Supprimer";
            deleteButton.addEventListener("click", async () => {
                await supabase
                    .from("evenements")
                    .delete()
                    .eq("id", evenement.id);
                if (editingEvent?.id === evenement.id) resetForm();
                loadEvents();
            });

            row.append(info, editButton, deleteButton);
            eventsList.appendChild(row);
        }
    }

    const session = await requireAdminSession();
    if (session) {
        adminPanel.hidden = false;
        adminEmail.textContent = session.user.email ?? "";
        loadEvents();
    }

    addEventForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        const formData = new FormData(addEventForm);

        let imageUrl: string | null = editingEvent?.image ?? null;
        const imageFile = formData.get("image") as File;
        if (imageFile && imageFile.size > 0) {
            if (!["image/jpeg", "image/png"].includes(imageFile.type)) {
                alert("L'image doit être au format JPG ou PNG.");
                return;
            }

            const path = `${crypto.randomUUID()}-${imageFile.name}`;
            const { error: uploadError } = await supabase.storage
                .from("evenements")
                .upload(path, imageFile);

            if (uploadError) {
                alert(uploadError.message);
                return;
            }

            imageUrl = supabase.storage
                .from("evenements")
                .getPublicUrl(path).data.publicUrl;
        }

        const eventPayload = {
            date: formData.get("date"),
            heure_debut: formData.get("heure_debut"),
            heure_fin: formData.get("heure_fin"),
            titre: formData.get("titre"),
            description: formData.get("description") || null,
            lien: formData.get("lien") || null,
            image: imageUrl,
        };

        const { error } = editingEvent
            ? await supabase
                  .from("evenements")
                  .update(eventPayload)
                  .eq("id", editingEvent.id)
            : await supabase.from("evenements").insert(eventPayload);

        if (error) {
            alert(error.message);
            return;
        }

        resetForm();
        loadEvents();
    });

    cancelEditButton.addEventListener("click", () => resetForm());

    logoutButton.addEventListener("click", async () => {
        await supabase.auth.signOut();
        window.location.href = "/admin/login";
    });
</script>
