---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Évènement - L'agenda">
    <div class="wrapper">
        <section class="evenement-detail">
            <a href="/l-agenda" class="back-link"
                ><i class="ph ph-arrow-left"></i> Retour à l'agenda</a
            >

            <div id="evenement-content" hidden>
                <img id="evenement-image" class="evenement-image" alt="" />

                <div class="evenement-date-badge">
                    <span id="evenement-jour" class="jour"></span>
                    <span id="evenement-mois" class="mois"></span>
                </div>

                <h1 id="evenement-titre"></h1>
                <p id="evenement-infos" class="infos"></p>
                <p id="evenement-description" class="description"></p>

                <a
                    id="evenement-lien"
                    href=""
                    target="_blank"
                    class="lien-externe"
                    hidden>Plus d'infos <i class="ph ph-arrow-up-right"></i
                    ></a
                >
            </div>

            <p id="evenement-not-found" class="not-found" hidden>
                Cet évènement n'existe pas ou n'est plus disponible.
            </p>
        </section>
    </div>
</Layout>

<style is:global>
    .evenement-detail {
        display: flex;
        flex-direction: column;
        gap: 24px;
        max-width: 700px;
        margin: 0 auto;
    }

    .evenement-detail .back-link {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: var(--color-body);
        align-self: flex-start;
    }

    #evenement-content {
        display: flex;
        flex-direction: column;
        gap: 16px;
        position: relative;
    }

    .evenement-image {
        align-self: center;
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 50vh;
        border-radius: var(--border-radius);
    }

    .evenement-date-badge {
        display: flex;
        flex-direction: column;
        align-items: center;
        line-height: 1;
        padding: 12px 16px;
        border-radius: var(--border-radius);
        background-color: var(--color-background);
        width: fit-content;
    }

    .evenement-date-badge .jour {
        font-size: 32px;
        font-weight: 800;
    }

    .evenement-date-badge .mois {
        font-size: 16px;
        font-weight: 800;
        text-transform: uppercase;
    }

    #evenement-titre {
        text-transform: uppercase;
    }

    .infos {
        font-weight: 600;
        color: var(--color-primary);
    }

    .description {
        white-space: pre-line;
    }

    .lien-externe {
        display: flex;
        align-items: center;
        gap: 4px;
        width: fit-content;
        color: var(--color-primary);
        text-decoration: underline;
        font-weight: 600;
    }

    .lien-externe[hidden] {
        display: none;
    }

    .not-found {
        opacity: 0.6;
    }
</style>

<script>
    import { supabase } from "../../lib/supabase.js";

    const content = document.querySelector<HTMLElement>("#evenement-content")!;
    const notFound =
        document.querySelector<HTMLElement>("#evenement-not-found")!;
    const image = document.querySelector<HTMLImageElement>("#evenement-image")!;
    const jour = document.querySelector<HTMLElement>("#evenement-jour")!;
    const mois = document.querySelector<HTMLElement>("#evenement-mois")!;
    const titre = document.querySelector<HTMLElement>("#evenement-titre")!;
    const infos = document.querySelector<HTMLElement>("#evenement-infos")!;
    const description =
        document.querySelector<HTMLElement>("#evenement-description")!;
    const lien = document.querySelector<HTMLAnchorElement>("#evenement-lien")!;

    const id = new URLSearchParams(window.location.search).get("id");

    if (!id) {
        notFound.hidden = false;
    } else {
        const { data: evenement, error } = await supabase
            .from("evenements")
            .select("*")
            .eq("id", id)
            .maybeSingle();

        if (error || !evenement) {
            notFound.hidden = false;
        } else {
            const date = new Date(`${evenement.date}T00:00:00`);

            document.title = `${evenement.titre} - L'agenda`;

            if (evenement.image) {
                image.src = evenement.image;
                image.alt = evenement.titre;
            } else {
                image.remove();
            }

            jour.textContent = date.toLocaleDateString("fr-FR", {
                day: "numeric",
            });
            mois.textContent = date.toLocaleDateString("fr-FR", {
                month: "short",
            });

            titre.textContent = evenement.titre;

            const dateComplete = date.toLocaleDateString("fr-FR", {
                weekday: "long",
                day: "numeric",
                month: "long",
                year: "numeric",
            });
            infos.textContent = `${dateComplete} · ${evenement.heure_debut.slice(0, 5)} – ${evenement.heure_fin.slice(0, 5)}`;

            if (evenement.description) {
                description.textContent = evenement.description;
            } else {
                description.remove();
            }

            if (evenement.lien) {
                lien.href = evenement.lien;
                lien.hidden = false;
            }

            content.hidden = false;
        }
    }
</script>
