rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /evenements/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
